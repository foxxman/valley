{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API игры. Спека собрана из комментариев над хендлерами, на сами запросы страница не смотрит.",
        "title": "Game API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/auth/login": {
            "post": {
                "description": "Проверяет логин и пароль. Дальше браузер сам отправляет cookie на запросы с этой страницы.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/credentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/player"
                        }
                    },
                    "400": {
                        "description": "invalid_body",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "401": {
                        "description": "invalid_credentials",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "security": [
                    {
                        "RefreshCookie": []
                    }
                ],
                "description": "Без refresh_token тоже отвечает 204 и стирает cookie.",
                "tags": [
                    "auth"
                ],
                "summary": "Выход",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Текущий игрок",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/player"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/refresh": {
            "post": {
                "security": [
                    {
                        "RefreshCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Обновить сессию",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/player"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/register": {
            "post": {
                "description": "Создаёт игрока. Токены приходят только в Set-Cookie: access_token и refresh_token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/credentials"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/player"
                        }
                    },
                    "400": {
                        "description": "invalid_body, invalid_login или invalid_password",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "409": {
                        "description": "login_taken",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/games": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Список своих игр",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/gameList"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Создать игру",
                "parameters": [
                    {
                        "description": "Название и необязательный сид",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/createGame"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/game"
                        }
                    },
                    "400": {
                        "description": "invalid_body, invalid_name или invalid_seed",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/games/{id}": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Игра по id",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/game"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "404": {
                        "description": "game_not_found",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Переименовать игру",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Новое название",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/gameName"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/game"
                        }
                    },
                    "400": {
                        "description": "invalid_body или invalid_name",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "403": {
                        "description": "forbidden",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "404": {
                        "description": "game_not_found",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/games/{id}/actions/gather": {
            "post": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "map"
                ],
                "summary": "Собрать цветок",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Клетка и вид цветка",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/gatherRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/gatherResult"
                        }
                    },
                    "400": {
                        "description": "invalid_body, invalid_kind или not_in_reach",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "404": {
                        "description": "game_not_found",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "409": {
                        "description": "already_taken или bag_full",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/games/{id}/inventory": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Инвентарь игрока",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/inventory"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "404": {
                        "description": "game_not_found",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/games/{id}/map": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "map"
                ],
                "summary": "Журнал карты",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID игры",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/mapJournal"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "404": {
                        "description": "game_not_found",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/api/ws": {
            "get": {
                "security": [
                    {
                        "AccessCookie": []
                    }
                ],
                "description": "Переключение протокола на WebSocket. Каталог событий в эту спецификацию не входит. Игра и сид запрашиваются обычными HTTP-ручками.",
                "tags": [
                    "realtime"
                ],
                "summary": "Канал сообщений",
                "responses": {
                    "101": {
                        "description": "WebSocket",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "$ref": "#/definitions/errorResponse"
                        }
                    }
                }
            }
        },
        "/healthcheck": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Проверка живости",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/health"
                        }
                    },
                    "503": {
                        "description": "База недоступна",
                        "schema": {
                            "$ref": "#/definitions/health"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "createGame": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Северная долина"
                },
                "worldSeed": {
                    "description": "Необязательный сид мира. Пустое значение — сервер выбирает его сам.",
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "credentials": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string",
                    "example": "player_one"
                },
                "password": {
                    "type": "string",
                    "example": "password1"
                }
            }
        },
        "errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string",
                            "example": "invalid_login"
                        },
                        "message": {
                            "type": "string",
                            "example": "Логин: 3–24 символа, латиница, цифры и подчёркивание"
                        }
                    }
                }
            }
        },
        "game": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string",
                    "example": "2026-01-02T15:04:05Z"
                },
                "id": {
                    "type": "string",
                    "example": "3f1c2a0e-7b4d-4e1a-9c2f-6d8e0a1b2c3d"
                },
                "name": {
                    "type": "string",
                    "example": "Северная долина"
                },
                "owner": {
                    "$ref": "#/definitions/player"
                },
                "updatedAt": {
                    "type": "string",
                    "example": "2026-01-02T15:04:05Z"
                },
                "worldSeed": {
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "gameList": {
            "type": "object",
            "properties": {
                "games": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/game"
                    }
                }
            }
        },
        "gameName": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Северная долина"
                }
            }
        },
        "gatherRequest": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "example": "flower-0"
                },
                "x": {
                    "type": "integer",
                    "example": 4
                },
                "y": {
                    "type": "integer",
                    "example": 5
                }
            }
        },
        "gatherResult": {
            "type": "object",
            "properties": {
                "capacity": {
                    "type": "integer",
                    "example": 20
                },
                "cell": {
                    "$ref": "#/definitions/mapCell"
                },
                "slots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/inventorySlot"
                    }
                }
            }
        },
        "health": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "boolean",
                    "example": true
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "inventory": {
            "type": "object",
            "properties": {
                "capacity": {
                    "type": "integer",
                    "example": 20
                },
                "slots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/inventorySlot"
                    }
                }
            }
        },
        "inventorySlot": {
            "type": "object",
            "properties": {
                "index": {
                    "type": "integer",
                    "example": 0
                },
                "item": {
                    "$ref": "#/definitions/item"
                },
                "quantity": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "item": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Сухие ветки"
                },
                "iconKey": {
                    "type": "string",
                    "example": "item-wood"
                },
                "id": {
                    "type": "string",
                    "example": "44444444-4444-4444-4444-444444444444"
                },
                "maxStack": {
                    "type": "integer",
                    "example": 20
                },
                "name": {
                    "type": "string",
                    "example": "Дерево"
                },
                "slug": {
                    "type": "string",
                    "example": "wood"
                }
            }
        },
        "mapCell": {
            "type": "object",
            "properties": {
                "layers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "x": {
                    "type": "integer",
                    "example": 1
                },
                "y": {
                    "type": "integer",
                    "example": 2
                }
            }
        },
        "mapJournal": {
            "type": "object",
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/mapCell"
                    }
                }
            }
        },
        "player": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "3f1c2a0e-7b4d-4e1a-9c2f-6d8e0a1b2c3d"
                },
                "login": {
                    "type": "string",
                    "example": "player_one"
                }
            }
        }
    },
    "securityDefinitions": {
        "AccessCookie": {
            "description": "HttpOnly cookie сессии. Её выставляют register и login, браузер шлёт её сам.",
            "type": "apiKey",
            "name": "access_token",
            "in": "cookie"
        },
        "RefreshCookie": {
            "description": "HttpOnly cookie обновления, path /api/auth. Нужна для refresh и logout.",
            "type": "apiKey",
            "name": "refresh_token",
            "in": "cookie"
        }
    }
}